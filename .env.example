SCADA_MODE=simulator
DEVICE_PROFILE=entes-mpr53s
MODBUS_TRANSPORT=tcp_rtu
MODBUS_HOST=192.168.1.50
MODBUS_PORT=5020
MODBUS_SERIAL_PORT=/dev/ttyUSB0
MODBUS_SLAVE_ID=1
MODBUS_BAUD=9600
MODBUS_PARITY=N
MODBUS_STOP_BITS=2
MODBUS_TIMEOUT_SECONDS=2
POLL_INTERVAL_SECONDS=2
DATABASE_PATH=./data/energy-scada.sqlite3
SCADA_TIMEZONE=Europe/Istanbul
MAX_EXPECTED_KW=500
